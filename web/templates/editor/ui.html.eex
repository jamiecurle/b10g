

<div class="parent">
  <iframe src="https://<%= @conn.assigns[:site].cname %>/<%=@post.slug %>">

  </iframe>
  <div class="form">

    <%= if @cs.action do %>
      <div class="alert alert-danger">
        <p>Oops, something went wrong! Please check the errors below.</p>
      </div>
    <% end %>

    <%= form_for @cs, editor_path(@conn, :update, @post.id), [id: "blog-form"], fn f -> %>

    <div class="form-group">
      <%= label f, :title %>
      <%= text_input f, :title, class: "form-control" %>
    </div>

    <div class="form-group">
      <%= label f, :slug %>
      <%= text_input f, :slug, class: "form-control" %>
    </div>

    <div class="form-group">
      <%= label f, :status %>
      <%= select f, :status, post_statuses, class: "form-control" %>
    </div>

    <div class="form-group">
      <span class="hide icon icon-resize-100" id="not-fullscreen"></span>
      <span class="icon icon-resize-full-screen" id="fullscreen"></span>
      <%= label f, :markdown %>
      <%= textarea f, :markdown, class: "form-control", style: "min-height: 400px" %>
    </div>


    <div class="form-group">
      <%= submit "Submit" , class: "btn btn-primary" %>

    </div>

    <% end %>

    <div id="drop-target" class="">
      <div>
        Drop files to upload
      </div>
    </div>
  </div>
</div>

<script>
  /* start utils */
  // CSRF protection
  window.csrf_token = "<%= get_csrf_token() %>"
  window.post_id = "<%= @post.id %>"

  // alias document.getElementById
  $id = function(id){
    return document.getElementById(id);
  }

  function random_string(){
    return Math.random().toString(36).substring(7)
  }

  /* end utils */

  // for dragging events
  function handleDragOver(e){
//    console.log("over")
    $id("post_markdown").classList.add("drag");
  }

  function handleLeave(e){
    $id("post_markdown").classList.remove("drag");
  }

  function handleDrop(e){
    $id("post_markdown").classList.remove("drag");
    handleFileUpload(e.dataTransfer.files[0])
    if (e.dataTransfer.files.length > 1){
      console.log("only one upload allowed for now....")
    }
    return false; // << needs to be there
  }
  // end dragging events

  // for paste event
  function handlePaste(e){
    var blob = e.clipboardData.items[0].getAsFile();
    switch (blob){
      case null:
        break;
      default:
        blob.name = random_string() + ".png";
        return handleFileUpload(blob)
    }
  }
  // end paste events

  // start file upload handlers
  /*
    - handleFileUpload
    - handleS3Upload
      - insertPlaceholderMarkdown
         - getSelection
      - uploadfile
        - updatePlaceholderMarkdown
  */


  function insertPlaceholderMarkdown(file){
    // make markdown
    let md = "![Uploading " +  file.name + "]()",

    // get cursor position
    cursor = $id("post_markdown").selectionEnd,

    // get start and finish
    start_text  = $id("post_markdown").value.slice(0, cursor),
        end_text = $id("post_markdown").value.slice(cursor);

    // update the text
    $id("post_markdown").value = start_text + "\n" + md + "\n" + end_text;

    // return the
    return md
  }

  function handleS3upload(url_data, file){

    // write in the markdown store it in tmp_md
    let tmp_md = insertPlaceholderMarkdown(file),

    // make the final markdown
    final_md = "![" + file.name + "](" + url_data.url + ")",

    // make an xhr
    req = new XMLHttpRequest();

    // upload to s3

    // these need to be set before we open the request
//    req.upload.addEventListener('progress', editor.uploadProgress, false);
//    req.upload.addEventListener('load', editor.uploadComplete, false);
//    req.upload.addEventListener('error', editor.uploadError, false);

    // open the request
    req.open('PUT', url_data.signed_url);

    // set the headers
    req.setRequestHeader('content-type', file.type);
    req.setRequestHeader('x-amz-acl', 'public-read');

    // send the file
    req.send(file);

    // When it's done, update the markdown
    req.onreadystatechange = function(e) {
      if (req.readyState == XMLHttpRequest.DONE && req.status == 200) {
        $id("post_markdown").value = $id("post_markdown").value.replace(tmp_md, final_md)
      }
    }

  }


  function handleFileUpload(file) {

      let req = new XMLHttpRequest();

      req.open("POST", "/editor/_sign/")
      req.setRequestHeader("x-csrf-token", window.csrf_token)
      req.setRequestHeader("x-post-id", window.post_id)
      req.setRequestHeader("x-filename", file.name)
      req.setRequestHeader("x-filetype", file.type)
      req.send()
      req.onreadystatechange = function(e){
        if (req.readyState == XMLHttpRequest.DONE && req.status == 200) {
          // parse response into json
          url = JSON.parse(req.responseText)
          handleS3upload(url, file)
        }
      }
  }


  // end file upload handlers

  // register handlers
  $id("post_markdown").ondragover = handleDragOver;
  $id("post_markdown").ondragleave = handleLeave;
  $id("post_markdown").ondrop = handleDrop;
  $id("post_markdown").onpaste = handlePaste;
  // end register handlers


  /* the fullscreen stuff */
  function toggle(e){
    // if keydown and escape or a click
    if ( (e.type == "keydown" && e.keyCode == 27) || e.type == "click"){
      document.getElementById("not-fullscreen").classList.toggle("hide")
      document.getElementById("post_markdown").classList.toggle("fullscreen")
    }
  }

  function save(e){
    if(e.metaKey && e.keyCode == 83){
      e.preventDefault(e);

      let form = document.getElementById('blog-form'),
          data = new FormData(form),
          req = new XMLHttpRequest();

      req.open("POST", "<%= editor_path(@conn, :update, @post.id) %>");
      req.send(data);
    }
  }

  // maximise and minimise when click
  document.getElementById("fullscreen").onclick = toggle;
  document.getElementById("not-fullscreen").onclick = toggle;
  document.addEventListener("keydown", toggle, false);

  // save
  document.addEventListener("keydown", save, false);

</script>