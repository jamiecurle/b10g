
<%= form_for @cs, editor_path(@conn, :ui, @post.id  ), fn f -> %>

<div class="form-group">
  <%= label f, :title %>
  <%= text_input f, :title, class: "form-control" %>
</div>

<div class="form-group">
  <%= label f, :slug %>
  <%= text_input f, :slug, class: "form-control" %>
</div>

<div class="form-group">
  <%= label f, :markdown %>
  <%= textarea f, :markdown, class: "form-control", style: "min-height: 600px" %>
</div>



<%= submit "Submit" , class: "btn btn-primary" %>
<% end %>