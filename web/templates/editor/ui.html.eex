
<%= form_for @cs, editor_path(@conn, :update, @post.id), fn f -> %>


<div class="form-group">
  <%= label f, :title %>
  <%= text_input f, :title, class: "form-control" %>
</div>

<div class="form-group">
  <%= label f, :slug %>
  <%= text_input f, :slug, class: "form-control" %>
</div>

<div class="form-group">
  <%= label f, :status %>
  <%= text_input f, :status, class: "form-control" %>
</div>

<div class="form-group">
  <%= label f, :markdown %>
  <%= textarea f, :markdown, class: "form-control", style: "min-height: 400px" %>
</div>



<%= submit "Submit" , class: "btn btn-primary" %>
<% end %>