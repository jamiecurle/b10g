<!DOCTYPE html>
<html lang="en">
<% colour = Map.get(@config, "COLOUR") ||  "#3e3e3e" %>
<% name = Map.get(@config, "NAME") ||  "??" %>
<% post = Map.get(@conn.assigns, :post) ||  nil %>
  <head>
    <!-- Global site tag (gtag.js) - Google Analytics -->
      <script async src="https://www.googletagmanager.com/gtag/js?id=UA-33704475-1"></script>
      <script>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());

        gtag('config', 'UA-33704475-1');
      </script>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta content="Jamie Curle" property="og:title">
    <meta content="Jamie Curle&#39;s documented journey of his mission to become a well rounded human being" name="description">
    <meta content="Jamie Curle&#39;s documented journey of his mission to become a well rounded human being" property="og:description">
    <meta content="https://jamiecurle.com/images/ogimage.png" property="og:image">
    <meta content="https://jamiecurle.com/images/ogimage.png" property="twitter:card">

    <title><%= name <> " – " <> @title %> </title>
    <link rel="stylesheet" href="<%= static_path(@conn, "/css/blog.css") %>">
    <link href="https://fonts.googleapis.com/css?family=Inconsolata" rel="stylesheet">

    <style>
      div#menu a:hover,
      a{
        color: <%= colour %>;
      }
      div#id p label,
      div#id p a,
      div#menu,
      body.index div.index a:hover{
        background-color: <%= colour %>;
      }
    </style>
  </head>


  <body class="<%= assigns[:class] || "index" %>">
    <%= if @conn.assigns[:current_user] && @conn.assigns[:display] == :standard do %>
      <input type="checkbox" id="menu-toggle">
      <div id="menu">
        <nav>
          <a href="/">Index</a>
          <a href="<%= editor_path(@conn, :create) %>">Create New Post</a>
          <a href="#">Settings</a>

          <%= if post do %>
            <a href="<%= editor_path(@conn, :ui, @post.id) %>">edit this post</a>
          <% end %>

        </nav>
      </div>
    <% end %>

    <div class="container">
      <%= if @conn.assigns[:display] == :standard do %>
        <div id="id">
          <p>
            <%= if @conn.assigns[:current_user] do %>
              <label for="menu-toggle"><%= {:safe,  ui_name(name)} %></label>
            <% else %>
              <a href="/"><%= {:safe,  ui_name(name)} %></a>
            <% end %>
          </p>
        </div>
        <% end %>

      <main role="main">
        <%= render @view_module, @view_template, assigns %>
      </main>

    </div>

    <script src="<%= static_path(@conn, "/js/vendor.js") %>"></script>
    <script src="<%= static_path(@conn, "/js/app.js") %>"></script>
  </body>
</html>
