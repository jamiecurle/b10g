
<div class="index">
<%= for post <- @posts do %>
  <div>
    <p>
      <a href="<%= page_path(@conn, :detail, post.id) %>">
        <%= if post.title do %>
          <%= post.title %>
          <% else %>
          UNTITLED <%= post.id %>
        <% end %>
       </a>
     </p>
   </div>
<% end %>
</div>