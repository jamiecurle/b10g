<div class="index">
  <%= for post <- @posts do %>
    <div class="<%= post.status %>">
      <p>
        <a href="<%= page_path(@conn, :detail, post.slug) %>">
          <%= if post.title do %>
              <%= post.title %>
            <% else %>
              UNTITLED <%= post.id %>
            <% end %>
            <br>
            <span><%= ui_time(post.inserted_at) %></span>
        </a>
      </p>
    </div>
  <% end %>
</div>
