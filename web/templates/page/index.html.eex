<div class="index">
  <div class="about" itemscope itemtype="http://schema.org/Person">
    <h1 itemprop="name">Jamie Curle </h1>
    <p itemprop="description">
     Hello, I'm on a mission <span itemprop="disambiguatingDescription">
     to be a well rounded human being</span> and this is my blog. At some
     point in November of 2018 I decided to start 134 days of Keto and
     weight training. I post here daily.
    </p>
    <p>
      You can also find me on 
      <a href="https://github.com/jamiecurle">Github,
      <a href="https://twitter.com/jamiecurle">Twitter</a>,
      <a href="https://www.linkedin.com/in/jamie-curle-67131190/">Linkedin</a>
      and
      <a href="https://keybase.io/jamiecurle">Keybase</a>.
    </p>
  </div>
  <%= for post <- @posts do %>
    <div class="post <%= post.status %>">
      <p>
        <a href="<%= page_path(@conn, :detail, post.slug) %>">
          <%= if post.title do %>
              <%= post.title %>
            <% else %>
              UNTITLED <%= post.id %>
            <% end %>
            <br>
            <span><%= ui_time(post.inserted_at) %></span>
        </a>
      </p>
    </div>
  <% end %>
</div>
